include pyproject.toml setup.py MANIFEST.in README.md README.en.md LICENSE NOTICE.md AGENTS.md
recursive-include src *.py py.typed
recursive-include docs *.md
recursive-include examples *.py
recursive-include tests *.py
recursive-include tools *.py *.md
recursive-include .github *.yml *.yaml
global-exclude *.py[cod] __pycache__ .DS_Store
